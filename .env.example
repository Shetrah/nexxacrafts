# Public Supabase project values. Never put a service-role key in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Set these as Supabase Edge Function secrets (do not use VITE_ and do not commit real values).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=YOUR_TWILIO_API_SECRET
# WhatsApp addresses in E.164 format; the function adds whatsapp: automatically if omitted.
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_WHATSAPP_TO=+2547XXXXXXXX
# Optional: approved Twilio WhatsApp Content Template SID (HX...). If omitted, sends a plain message.
TWILIO_WHATSAPP_CONTENT_SID=
